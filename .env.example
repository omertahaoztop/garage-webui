# garage-webui configuration — copy to .env and adjust.
# All values are environment variables; the same names work in Docker/compose.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3909
# Subpath prefix when hosted behind a reverse proxy at a non-root path,
# e.g. BASE_PATH=/garage  ->  https://infra.example.com/garage/
BASE_PATH=

# ---------------------------------------------------------------------------
# Authentication (STRONGLY recommended in production)
# ---------------------------------------------------------------------------
# Admin login. Format: username:bcrypt_hash  (generate with `make gen-password`).
# This is the ONLY way to get cluster-admin. S3 keys never become admin.
AUTH_USER_PASS=

# Fail closed: require authentication even if no provider above is set.
# Leave unset for dev; set to "true" in production as a safety net.
AUTH_REQUIRED=

# ---------------------------------------------------------------------------
# Single-cluster mode (default).  Ignored when CLUSTERS_CONFIG is set.
# ---------------------------------------------------------------------------
# Garage admin API endpoint (internal/local in a sidecar deployment).
API_BASE_URL=http://127.0.0.1:3903
# Garage admin token (static). Prefer dynamic admin tokens where possible.
API_ADMIN_KEY=
# Garage metrics token (for the dashboard /metrics scrape). Falls back to the
# admin token if unset (which Garage may reject — set this explicitly).
API_METRICS_KEY=
# Internal S3 endpoint used for all server-side object proxying.
S3_ENDPOINT_URL=http://127.0.0.1:3900
# Browser-reachable S3 host used to SIGN presigned URLs (e.g. the public host
# behind your edge load balancer). Falls back to S3_ENDPOINT_URL if unset.
# In a sidecar + edge-LB topology this MUST be the public host, e.g.
# S3_PUBLIC_ENDPOINT_URL=https://garage.example.com
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=garage
# Path to garage.toml for auto-detecting the above when not set explicitly.
CONFIG_PATH=/etc/garage.toml

# ---------------------------------------------------------------------------
# Multi-cluster mode (optional). When set, the per-cluster env vars above are
# ignored and clusters are loaded from this YAML registry.
# ---------------------------------------------------------------------------
# CLUSTERS_CONFIG=/etc/garage-webui/clusters.yaml

# ---------------------------------------------------------------------------
# OIDC / SSO (optional). When enabled, a "Sign in with SSO" button appears.
# ---------------------------------------------------------------------------
# OIDC_CONFIG=/etc/garage-webui/oidc.yaml
# Referenced by oidc.yaml's client_secret_env (name is up to you):
# OIDC_CLIENT_SECRET=
